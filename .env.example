# URL pública de la API de conversión (Render). En Vercel se configura como
# variable de entorno del proyecto; en local, copia este archivo a .env.local.
NEXT_PUBLIC_API_URL=https://api-conversor-gvzr.onrender.com

# API key para el endpoint protegido de Render. Debe ser LA MISMA que la env
# `API_KEY` del backend. Déjala vacía si el backend no tiene API_KEY definida.
# CAVEAT: NEXT_PUBLIC_* se incrusta en el bundle del navegador y es visible en la
# pestaña Network — frena bots y accesos a la URL "pelada", no es un secreto fuerte.
NEXT_PUBLIC_API_KEY=
